---
// Pills are labels or toggles, never buttons.
//   kind="topic": topic tag, a link to Product Lessons filtered by that topic
//   kind="chip":  filter chip, a toggle (aria-pressed); selected chips invert and show ✓
//   kind="soon":  Coming soon tag after a disabled item
interface Props {
  kind: 'topic' | 'chip' | 'soon';
  topic?: string;      // topic as written in a lesson, e.g. "Roadmap" (topic, chip)
  pressed?: boolean;   // chip only
  size?: 'md' | 'lg';  // topic only; lg is the About page size
}
const { kind, topic, pressed = false, size = 'md' } = Astro.props;
import { topicSlug } from '../lib/lessons';
const slug = topic ? topicSlug(topic) : undefined;
---
{kind === 'topic' && (
  <a class:list={['topic-tag', { 'topic-tag--lg': size === 'lg' }]} href={`/lessons?topic=${slug}`}><slot /></a>
)}
{kind === 'chip' && (
  <button type="button" class="chip" data-tag={slug} aria-pressed={String(pressed)}><slot /></button>
)}
{kind === 'soon' && <span class="soon-tag"><slot>Coming soon</slot></span>}
