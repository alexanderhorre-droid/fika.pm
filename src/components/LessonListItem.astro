---
import '../styles/lesson-list.css';
import { formatDate, topicSlug, type Lesson } from '../lib/lessons';
interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const { title, date, topics } = lesson.data;
---
<article class="post" data-topics={topics.map(topicSlug).join(' ')}>
  <p class="meta" data-sprinkles-clear="lines"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>
  <h3 data-sprinkles-clear="lines"><a href={`/lessons/${lesson.id}`}>{title}</a></h3>
</article>
