---
// Everything in <head>: meta, fonts, tokens, base styles and the theme bootstrap.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/parts.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 'article' for lessons, with their publish date */
  type?: 'website' | 'article';
  published?: Date;
}
const {
  title,
  description = 'Bite‑sized product lessons for PMs: pragmatic notes you can read on a coffee break and use the same day.',
  noindex = false,
  type = 'website',
  published,
} = Astro.props;
const ogImage = new URL('/og-image.png', Astro.site);
// Clean address: no .html, no trailing /index (the static build sees /lessons/x.html).
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f5efe6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#15171a" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="fika.pm · Product Lessons" href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Sharing: link previews in Slack, LinkedIn, iMessage and so on -->
<meta property="og:site_name" content="fika.pm" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="fika.pm: Bite‑sized product lessons for PMs" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

<!-- Only four families: Instrument Serif, Public Sans, IBM Plex Mono, Bungee (self-hosted, see astro.config.mjs).
     Preload the three that set the first screen (serif, sans, and Bungee for the FIKA.PM wordmark). -->
<Font cssVariable="--font-serif" preload />
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-wordmark" preload />

<!-- Dark mode follows the device; a saved choice from the nav switch overrides it. Runs before paint. -->
<script is:inline>
  document.documentElement.classList.add('js');
  try {
    var t = localStorage.getItem('fika-theme');
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
