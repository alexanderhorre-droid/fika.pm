---
// Everything in <head>: meta, fonts, tokens, base styles and the theme bootstrap.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/parts.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Bite‑sized product lessons for PMs: pragmatic notes you can read on a coffee break and use the same day.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f5efe6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#15171a" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Only four families: Instrument Serif, Public Sans, IBM Plex Mono, Bungee (self-hosted, see astro.config.mjs).
     Preload the two that set the first screen. -->
<Font cssVariable="--font-serif" preload />
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-wordmark" />

<!-- Dark mode follows the device; a saved choice from the nav switch overrides it. Runs before paint. -->
<script is:inline>
  document.documentElement.classList.add('js');
  try {
    var t = localStorage.getItem('fika-theme');
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
