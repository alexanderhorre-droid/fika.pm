---
// S03 gate page: the empty shell with the nav bar and a stand-in footer, showing the content edge. Not linked; noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Layout shell · fika.pm" noindex>
  <section class="block">
    <p class="label text-muted">S03 · layout shell</p>
    <h1>One content edge</h1>
    <p class="reading">Every section, the nav bar and the footer share the same container: 72rem wide with a fluid gutter. The dashed lines mark it; right edges line up from top to bottom.</p>
  </section>

  <section class="block">
    <h2>Reading width</h2>
    <p class="reading">Lesson text, post titles and the About body sit at 44.75rem (716px), aligned to the left of the content edge. This paragraph is at reading width so you can see where it stops against the full-width container.</p>
  </section>

  <section class="block block--full">
    <h2>Full width</h2>
    <p>This block fills the whole content edge.</p>
  </section>

  <footer slot="footer" class="wide stand-in stand-in--footer">
    <span class="label">Footer slot · footer arrives in S05</span>
  </footer>
</BaseLayout>

<style>
  .stand-in { display: flex; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; padding: var(--space-3) 0; outline: 1px dashed var(--color-text-muted); outline-offset: -1px; padding-inline: var(--space-2); }
  .stand-in--footer { margin-bottom: var(--space-5); }
  .block { padding: var(--space-4) 0; border-top: 1px solid var(--color-border); display: grid; gap: var(--space-2); }
  .block:first-child { border-top: 0; }
  :global(.site-main) { outline: 1px dashed var(--color-text-muted); outline-offset: -1px; }
  h1 { font-size: max(42px, min(99px, 7.83vw)); line-height: 1.05; letter-spacing: -0.01em; }
  @media (max-width: 63.99rem) { h1 { font-size: var(--hero-size-sm); } }
  h2 { font-size: var(--text-h2); }
  .reading { background: color-mix(in srgb, var(--color-border) 45%, transparent); }
  .bp { display: none; }
  .bp::before { content: "Phone · under 40rem"; }
  @media (min-width: 40rem) { .bp::before { content: "Tablet · 40–64rem"; } }
  @media (min-width: 64rem) { .bp::before { content: "Desktop · 64rem and up"; } }
</style>
