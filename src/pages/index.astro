---
// S01 placeholder. Replaced by the real home page in S07.
const title = 'fika.pm · Bite‑sized product lessons for PMs';
const description = 'Bite‑sized product lessons for PMs: pragmatic notes you can read on a coffee break and use the same day.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 1.125rem/1.6 system-ui, sans-serif; background: #f5efe6; color: #1b1e22; }
      @media (prefers-color-scheme: dark) { body { background: #15171a; color: #f2f3f4; } }
      main { padding: 2rem; text-align: center; }
      h1 { font-size: 2rem; margin: 0 0 .5rem; letter-spacing: -0.01em; }
      p { margin: 0; color: #555c64; }
      @media (prefers-color-scheme: dark) { p { color: #a7adb4; } }
    </style>
  </head>
  <body>
    <main>
      <h1>fika.pm</h1>
      <p>Bite‑sized product lessons for PMs. Brewing now.</p>
    </main>
  </body>
</html>
