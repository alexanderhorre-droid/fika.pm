---
// Placeholder home until S07.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="fika.pm · Bite‑sized product lessons for PMs">
  <div class="placeholder">
    <h1>Bite‑sized product lessons for PMs</h1>
    <p class="text-muted"><span class="brand-inline">fika.pm</span> is brewing.</p>
  </div>
</BaseLayout>

<style>
  :global(.site-main:has(.placeholder)) { display: grid; place-items: center; }
  .placeholder { text-align: center; }
  h1 { font-size: clamp(2.5rem, 2rem + 3vw, 4rem); letter-spacing: -0.01em; margin-bottom: var(--space-2); }
</style>
