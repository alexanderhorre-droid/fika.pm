---
// S07 home: masthead · standfirst · recent lessons.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Highlight from '../components/Highlight.astro';
import Button from '../components/Button.astro';
import LessonListItem from '../components/LessonListItem.astro';
import { getLessons } from '../lib/lessons';

const recent = (await getLessons()).slice(0, 3);
---
<BaseLayout
  title="fika.pm · Bite‑sized product lessons for PMs"
  description="fika.pm is a growing collection of bite‑sized product lessons. Drawn from years of leading empowered product teams, they cover craft, frameworks, first principles and industry insight."
  current="home"
>
  <Masthead portrait={false}>
    <h1 class="hero-heading hero-heading--fit"><span class="line">Bite‑sized product</span> <span class="line">lessons for PMs</span></h1>
  </Masthead>

  <div class="intro-row">
    <section class="standfirst" aria-label="About fika.pm">
      <p class="standfirst-text"><Highlight class="brand-inline">fika.pm</Highlight> is a growing collection of bite‑sized product lessons. Drawn from years of leading empowered product teams, they cover craft, frameworks, first principles and industry insight.</p>
    </section>
  </div>

  <section aria-labelledby="recent-lessons">
    <SectionHeading id="recent-lessons">Recent lessons</SectionHeading>
    {recent.map((lesson) => <LessonListItem lesson={lesson} />)}
    <div class="list-more">
      <Button href="/lessons" arrow>View all lessons</Button>
    </div>
  </section>
</BaseLayout>
