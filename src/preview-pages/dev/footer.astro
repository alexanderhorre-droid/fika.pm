---
// S05 gate page: the footer. Not linked; noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Footer · fika.pm" noindex>
  <div class="reading stack">
    <p class="label text-muted">S05 · footer</p>
    <h1>Footer check</h1>
    <p>Scroll down. Press <strong>Copy my email</strong>: the button reads “Email copied ✓” for two seconds and alex@fika.pm is on your clipboard. Paste it somewhere to confirm. Try it in Safari, Chrome and on your iPhone.</p>
    <p>LinkedIn opens your profile in a new tab. Hover the author card to pause the head turn.</p>
  </div>
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--space-3); padding-top: var(--space-5); }
  h1 { font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem); line-height: 1.05; }
</style>
